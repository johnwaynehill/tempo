DATABASE_URL=postgresql://postgres:PASSWORD@host:5432/railway
FIREBASE_PROJECT_ID=tempo-b11a9
ANTHROPIC_API_KEY=sk-ant-...
PORT=3001

# Dev Auth Bypass — set a secret token to enable (must match VITE_DEV_AUTH_TOKEN in root .env)
# DEV_AUTH_TOKEN=my-secret-dev-token

# Shared secret guarding /api/internal/autoplan. The autoplan-cron Railway
# service must send this in the X-Autoplan-Secret header. Endpoint is
# disabled (returns 503) when this is unset — safer than open-by-default.
# AUTOPLAN_SECRET=set-me-to-something-long-and-random
