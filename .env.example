# Dev Auth Bypass — skips Firebase auth and uses a mock test user
# Set a shared secret token here AND in api/.env as DEV_AUTH_TOKEN to enable
# VITE_DEV_AUTH_TOKEN=my-secret-dev-token

# Firebase Configuration
# Get these from https://console.firebase.google.com → Project Settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI Features
# For local dev: set your Anthropic API key (proxied through Vite dev server)
VITE_ANTHROPIC_API_KEY=

# For production: URL of the deployed Cloud Function proxy
# e.g. https://anthropicproxy-XXXX-uc.a.run.app
VITE_ANTHROPIC_PROXY_URL=
